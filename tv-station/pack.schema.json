{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/TheMightyTRex/starboard-plugins/main/tv-station/pack.schema.json",
 "title": "Broadcast pack for Create your own TV channel",
 "description": "pack.json at the top of a broadcast pack. Every position is in pixels of a 1920 by 1080 picture, as [left, top, right, bottom].",
 "type": "object",
 "required": ["pack", "name"],
 "additionalProperties": false,
 "properties": {
  "pack": {"description": "The version of this specification. Always 1.", "const": 1},
  "name": {"description": "The pack's name, shown in Starboard.", "type": "string", "minLength": 1, "maxLength": 40},
  "made": {"description": "When it was made, in words. Shown in Starboard.", "type": "string", "maxLength": 40},
  "author": {"description": "Who made it.", "type": "string", "maxLength": 60},
  "size": {"description": "Always [1920, 1080]: the size the positions are measured on.", "type": "array",
           "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
  "fps": {"description": "Always 25.", "type": "integer", "minimum": 25, "maximum": 25},
  "colours": {"type": "object", "additionalProperties": false,
              "properties": {"text": {"$ref": "#/$defs/colour"}, "accent": {"$ref": "#/$defs/colour"}}},
  "logo": {"type": "object", "additionalProperties": false,
           "properties": {"dog": {"const": "logo/dog.png"},
                          "with_music": {"type": "string", "pattern": "^logo/logo-with-music\\.(mp4|mov)$"}}},
  "idents": {"description": "The idents in idents/, for a check that none is missing. Every identNN file in the folder is used.",
             "type": "array", "maxItems": 99, "items": {"type": "string", "pattern": "^ident[0-9]{2,3}\\.(mp4|mov|mkv|webm)$"}},
  "coming_next": {"$ref": "#/$defs/layout"},
  "promo": {"allOf": [{"$ref": "#/$defs/layout"}],
            "properties": {"music": {"type": "array", "maxItems": 20,
                                     "items": {"type": "string", "pattern": "^promo/music/[A-Za-z0-9 _.-]{1,60}\\.(m4a|mp3|wav|flac|ogg|opus)$"}},
                           "seconds": {"description": "How long each promo is. 15 unless you change it.", "type": "integer", "minimum": 10, "maximum": 30}}},
  "transitions": {"type": "array", "maxItems": 20, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}\\.(webm|mov)$"}}
 },
 "$defs": {
  "colour": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
  "rect": {"description": "[left, top, right, bottom] in pixels of 1920 by 1080.", "type": "array", "minItems": 4, "maxItems": 4,
           "items": {"type": "integer", "minimum": 0, "maximum": 1920}},
  "field": {"oneOf": [
   {"$ref": "#/$defs/rect"},
   {"type": "object", "required": ["box"], "additionalProperties": false,
    "properties": {"box": {"$ref": "#/$defs/rect"}, "colour": {"$ref": "#/$defs/colour"},
                   "align": {"enum": ["left", "centre", "right"]}, "lines": {"type": "integer", "minimum": 1, "maximum": 4}}}]},
  "layout": {"type": "object", "required": ["background", "clip", "fields"],
             "properties": {"background": {"type": "string", "pattern": "^(coming-next|promo)/background\\.(mp4|mov|png|jpg|jpeg)$"},
                            "clip": {"$ref": "#/$defs/rect"},
                            "fields": {"type": "object", "minProperties": 1,
                                       "propertyNames": {"enum": ["Heading", "Title", "Episode", "Day and time", "Synopsis", "Channel name"]},
                                       "additionalProperties": {"$ref": "#/$defs/field"}},
                            "music": {}, "seconds": {}},
             "additionalProperties": false}
 }
}
