  "featured": {
    "chip": "New and recommended",
    "title": "Direct play",
    "text": "Makes your films and series play directly on the devices you choose, so Jellyfin does not convert them as they play. It works one file at a time, in the hours you choose, and checks each file before it replaces it.",
    "to": "plugins/direct-play/index.html",
    "flow": "start: A file your devices cannot play\nstepfix: Repackage or add a sound track\nstepcheck: Check the new file\nend: Plays directly"
  },
