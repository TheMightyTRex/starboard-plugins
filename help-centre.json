{
  "name": "Starboard plug-ins",
  "title": "Starboard plug-ins help",
  "repo": "https://github.com/TheMightyTRex/starboard-plugins",
  "site": "https://themightytrex.github.io/starboard-plugins/help/",
  "help_dir": "help",
