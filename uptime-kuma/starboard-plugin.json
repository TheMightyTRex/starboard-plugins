{
 "manifest_version": 1,
 "id": "uptime-kuma",
 "name": "Uptime Kuma",
 "version": "1.0.0",
 "description": "Uptime Kuma, status checks for websites and services, with alerts and status pages. Starboard already watches your apps; this is for more.",
 "author": "TheMightyTRexUK",
 "licence": "MIT",
 "homepage": "https://github.com/TheMightyTRex/starboard-plugins/tree/main/uptime-kuma",
 "support_url": "https://github.com/TheMightyTRex/starboard-plugins/issues",
 "starboard_api": ">=1.13 <2.0",
 "permissions": [
  "network:lan",
  "network:port"
 ],
 "containers": [
  {
   "name": "app",
   "image": "docker.io/louislam/uptime-kuma@sha256:d213a1d2b6a7d7c00afbcb936b53f585afea3e1620432b3a161b68bfffa13dac",
   "port": 3001,
   "network": "lan",
   "publish": true,
   "host_port": 3001,
   "user": "1000:1000",
   "volumes": [
    "data:/app/data"
   ]
  }
 ],
 "resources": {
  "app": {
   "memory": 384,
   "cpus": 0.5,
   "pids": 128
  }
 },
 "changes": [
  {
   "version": "1.0.0",
   "date": "2026-11-13",
   "added": [
    "Uptime Kuma as a plug-in, outside the main install, on its own page on your home network."
   ]
  }
 ]
}
