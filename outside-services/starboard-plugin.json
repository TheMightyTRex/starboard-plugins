{
 "manifest_version": 1,
 "id": "outside-services",
 "name": "Outside services",
 "version": "1.0.0",
 "description": "Up or down for things that are not on this server: your router, a NAS, a website.",
 "author": "TheMightyTRexUK",
 "licence": "MIT",
 "homepage": "https://github.com/TheMightyTRex/starboard-plugins/tree/main/outside-services",
 "support_url": "https://github.com/TheMightyTRex/starboard-plugins/issues",
 "starboard_api": ">=1.1 <2.0",
 "permissions": [
  "network:lan"
 ],
 "containers": [
  {
   "name": "main",
   "image": "ghcr.io/themightytrex/starboard-plugin-examples:1.0.0",
   "port": 8080,
   "network": "lan",
   "volumes": [
    "data"
   ],
   "command": [
    "python3",
    "/app/outside-services/app.py"
   ]
  }
 ],
 "resources": {
  "main": {
   "memory": 48,
   "cpus": 0.1
  }
 },
 "health": "/health",
 "settings": [
  {
   "key": "addresses",
   "label": "Addresses to check",
   "type": "list",
   "hint": "One each, such as http://192.168.1.1 or https://example.org. Give a name first if you like: Router http://192.168.1.1"
  },
  {
   "key": "minutes",
   "label": "Check every",
   "type": "number",
   "unit": "minutes",
   "default": 5,
   "min": 1,
   "max": 60
  }
 ],
 "cards": [
  {
   "id": "summary",
   "title": "Outside services",
   "type": "status",
   "path": "/status",
   "example": {
    "state": "ok",
    "text": "All 4 answer"
   }
  },
  {
   "id": "list",
   "title": "Outside services",
   "type": "list",
   "path": "/card",
   "example": {
    "items": [
     {
      "title": "Router",
      "detail": "Up, 4 ms"
     }
    ]
   }
  }
 ]
}
