{
 "manifest_version": 1,
 "id": "seasonal-styles",
 "name": "Seasonal styles",
 "version": "1.0.0",
 "description": "Two more styles for Display: Winter, in deep green and berry red, and Large and clear, for easy reading.",
 "author": "TheMightyTRexUK",
 "licence": "MIT",
 "homepage": "https://github.com/TheMightyTRex/starboard-plugins/tree/main/seasonal-styles",
 "support_url": "https://github.com/TheMightyTRex/starboard-plugins/issues",
 "starboard_api": ">=1.1 <2.0",
 "permissions": [
  "appearance:styles"
 ],
 "containers": [],
 "styles": [
  {
   "id": "winter",
   "name": "Winter",
   "description": "Deep pine green and berry red, warm and calm for the darker months.",
   "radius": 10,
   "font": "hyperlegible",
   "shadow": "soft",
   "light": {
    "bg": "#f3f6f2",
    "header": "#fbfcfa",
    "surface": "#f7f9f6",
    "surface_raised": "#ffffff",
    "surface_sunken": "#e3eae1",
    "text": "#132018",
    "text_muted": "#3f5145",
    "border": "#6b7d70",
    "divider": "#cbd6cd",
    "accent": "#a3172f",
    "accent_text": "#ffffff",
    "accent_soft": "#f8e1e5",
    "focus": "#1d5a36"
   },
   "dark": {
    "bg": "#0b1510",
    "header": "#0f1d16",
    "surface": "#11211a",
    "surface_raised": "#172b22",
    "surface_sunken": "#07100b",
    "text": "#eaf2ec",
    "text_muted": "#a9bcae",
    "border": "#6f8a78",
    "divider": "#24392d",
    "accent": "#ff8a9c",
    "accent_text": "#0b1510",
    "accent_soft": "#3b1820",
    "focus": "#8fd6a8"
   }
  },
  {
   "id": "large-clear",
   "name": "Large and clear",
   "description": "Strong contrast, wide focus rings and a heavier font, for easy reading.",
   "radius": 4,
   "font": "hyperlegible",
   "shadow": "none",
   "heading_weight": 800,
   "focus_width": 4,
   "light": {
    "bg": "#ffffff",
    "header": "#ffffff",
    "surface": "#ffffff",
    "surface_raised": "#ffffff",
    "surface_sunken": "#eeeeee",
    "text": "#000000",
    "text_muted": "#2b2b2b",
    "border": "#4a4a4a",
    "divider": "#8a8a8a",
    "accent": "#0040b0",
    "accent_text": "#ffffff",
    "accent_soft": "#dfe8fb",
    "focus": "#000000"
   },
   "dark": {
    "bg": "#000000",
    "header": "#000000",
    "surface": "#000000",
    "surface_raised": "#111111",
    "surface_sunken": "#000000",
    "text": "#ffffff",
    "text_muted": "#dddddd",
    "border": "#b5b5b5",
    "divider": "#6b6b6b",
    "accent": "#ffd23f",
    "accent_text": "#000000",
    "accent_soft": "#3a3000",
    "focus": "#ffffff"
   }
  }
 ]
}
