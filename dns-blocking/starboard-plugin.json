{
 "manifest_version": 1,
 "id": "dns-blocking",
 "name": "Ad blocking",
 "version": "1.0.0",
 "description": "How many adverts and trackers Pi-hole or AdGuard Home blocked today.",
 "author": "TheMightyTRexUK",
 "licence": "MIT",
 "homepage": "https://github.com/TheMightyTRex/starboard-plugins/tree/main/dns-blocking",
 "support_url": "https://github.com/TheMightyTRex/starboard-plugins/issues",
 "starboard_api": ">=1.1 <2.0",
 "permissions": [
  "network:lan"
 ],
 "containers": [
  {
   "name": "main",
   "image": "ghcr.io/themightytrex/starboard-plugin-dns-blocking:1.0.0",
   "port": 8080,
   "network": "lan"
  }
 ],
 "resources": {
  "main": {
   "memory": 48,
   "cpus": 0.1
  }
 },
 "health": "/health",
 "settings": [
  {
   "key": "kind",
   "label": "Which one",
   "type": "choice",
   "choices": [
    "Pi-hole",
    "AdGuard Home"
   ],
   "default": "Pi-hole"
  },
  {
   "key": "address",
   "label": "Its address",
   "type": "address",
   "hint": "Such as http://192.168.1.2 for Pi-hole, or http://192.168.1.2:3000 for AdGuard Home."
  },
  {
   "key": "username",
   "label": "User name",
   "type": "text",
   "hint": "AdGuard Home only."
  },
  {
   "key": "password",
   "label": "Password",
   "type": "secret",
   "hint": "Pi-hole's web password, or AdGuard Home's. Kept by Starboard."
  }
 ],
 "cards": [
  {
   "id": "blocked",
   "title": "Blocked today",
   "type": "stat",
   "path": "/card",
   "format": "number",
   "example": {
    "value": 4210,
    "label": "blocked",
    "note": "12% of 35,000 lookups"
   }
  }
 ]
}
