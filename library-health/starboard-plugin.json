{
 "manifest_version": 1,
 "id": "library-health",
 "name": "Library health",
 "version": "1.1.0",
 "description": "Films and series in Jellyfin with no poster, no description or no year, so you can fix them.",
 "author": "TheMightyTRexUK",
 "licence": "MIT",
 "homepage": "https://github.com/TheMightyTRex/starboard-plugins/tree/main/library-health",
 "support_url": "https://github.com/TheMightyTRex/starboard-plugins/issues",
 "starboard_api": ">=1.14 <2.0",
 "permissions": [
  "jellyfin:key",
  "network:lan"
 ],
 "containers": [
  {
   "name": "main",
   "image": "ghcr.io/themightytrex/starboard-plugin-examples:1.2.0",
   "port": 8080,
   "network": "lan",
   "volumes": [
    "data"
   ],
   "env": {
    "EXAMPLE": "library-health"
   }
  }
 ],
 "resources": {
  "main": {
   "memory": 96,
   "cpus": 0.25
  }
 },
 "health": "/health",
 "actions": [
  {
   "id": "check",
   "label": "Check now",
   "path": "/check"
  }
 ],
 "cards": [
  {
   "id": "count",
   "title": "Library health",
   "type": "stat",
   "path": "/count",
   "format": "number",
   "example": {
    "value": 4,
    "label": "to fix",
    "note": "of 1,240 titles",
    "status": "warning",
    "status_label": "4 titles to fix",
    "updated": 1794694110
   }
  },
  {
   "id": "list",
   "title": "To fix in Jellyfin",
   "type": "list",
   "path": "/card",
   "example": {
    "items": [
     {
      "title": "Brazil (1985)",
      "detail": "No poster"
     }
    ],
    "status": "warning",
    "status_label": "4 titles to fix",
    "updated": 1794694110
   }
  }
 ],
 "update": {
  "before": {
   "path": "/update/before",
   "time_limit_seconds": 60
  },
  "after": {
   "path": "/update/after",
   "time_limit_seconds": 10
  }
 },
 "logo": {
  "file": "logo.svg",
  "alt": "A clipboard with a tick"
 },
 "changes": [
  {
   "version": "1.1.0",
   "date": "2026-11-15",
   "added": [
    "**A logo** in Settings, Plug-ins, in the Catalogue and on its dashboard cards.",
    "**Its cards say how things are:** a status and when they last changed, in the grey band at the top of each card.",
    "**Updates safely:** before an update it finishes what it is doing and starts nothing new."
   ],
   "changed": [
    "Needs Starboard with plug-in API 1.14 or later. A Starboard with an older plug-in API keeps version 1.0.0."
   ]
  },
  {
   "version": "1.0.0",
   "date": "2026-11-12",
   "added": [
    "Films and series in Jellyfin with no poster, no description or no year, so you can fix them."
   ]
  }
 ]
}
