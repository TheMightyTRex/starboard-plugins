{
 "manifest_version": 1,
 "id": "maintainerr",
 "name": "Maintainerr",
 "version": "1.0.0",
 "description": "Maintainerr, clean-up rules for Jellyfin, such as films everyone has watched. It changes nothing until you give it keys and a rule that removes.",
 "author": "TheMightyTRexUK",
 "licence": "MIT",
 "homepage": "https://github.com/TheMightyTRex/starboard-plugins/tree/main/maintainerr",
 "support_url": "https://github.com/TheMightyTRex/starboard-plugins/issues",
 "starboard_api": ">=1.13 <2.0",
 "permissions": [
  "network:lan",
  "network:port"
 ],
 "needs": [
  "jellyfin"
 ],
 "containers": [
  {
   "name": "app",
   "image": "ghcr.io/maintainerr/maintainerr@sha256:5dcd5bef9d49c614bb74453df3da198afc05a38d8e2cd96b3669bc2c76a94112",
   "port": 6246,
   "network": "lan",
   "publish": true,
   "host_port": 6246,
   "user": "1000:1000",
   "volumes": [
    "data:/opt/data"
   ]
  }
 ],
 "resources": {
  "app": {
   "memory": 384,
   "cpus": 0.5,
   "pids": 128
  }
 },
 "changes": [
  {
   "version": "1.0.0",
   "date": "2026-11-13",
   "added": [
    "Maintainerr as a plug-in, outside the main install, on its own page on your home network."
   ]
  }
 ]
}
