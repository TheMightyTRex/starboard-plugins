{
 "manifest_version": 1,
 "id": "seerr",
 "name": "Seerr",
 "version": "1.0.0",
 "description": "Seerr, a requests page for Jellyfin users. Reelix already has requests in Starboard, so most people do not need it.",
 "author": "TheMightyTRexUK",
 "licence": "MIT",
 "homepage": "https://github.com/TheMightyTRex/starboard-plugins/tree/main/seerr",
 "support_url": "https://github.com/TheMightyTRex/starboard-plugins/issues",
 "starboard_api": ">=1.13 <2.0",
 "permissions": [
  "network:lan",
  "network:port"
 ],
 "needs": [
  "jellyfin"
 ],
 "containers": [
  {
   "name": "app",
   "image": "ghcr.io/seerr-team/seerr@sha256:aadee014b40e28cf9aa4928bc9d1183a6eb08f8c44d543cddc9efdcb16549be2",
   "port": 5055,
   "network": "lan",
   "publish": true,
   "host_port": 5055,
   "user": "1000:1000",
   "volumes": [
    "data:/app/config"
   ]
  }
 ],
 "resources": {
  "app": {
   "memory": 512,
   "cpus": 0.5,
   "pids": 128
  }
 },
 "changes": [
  {
   "version": "1.0.0",
   "date": "2026-11-13",
   "added": [
    "Seerr as a plug-in, outside the main install, on its own page on your home network."
   ]
  }
 ]
}
