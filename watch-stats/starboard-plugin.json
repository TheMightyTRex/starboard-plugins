{
 "manifest_version": 1,
 "id": "watch-stats",
 "name": "Watch statistics",
 "version": "1.0.0",
 "description": "What was watched, by whom and when, and the top titles, from Jellyfin's Playback Reporting, with no second database.",
 "author": "TheMightyTRexUK",
 "licence": "MIT",
 "homepage": "https://github.com/TheMightyTRex/starboard-plugins/tree/main/watch-stats",
 "support_url": "https://github.com/TheMightyTRex/starboard-plugins/issues",
 "starboard_api": ">=1.11 <2.0",
 "permissions": [
  "jellyfin:key",
  "network:lan"
 ],
 "needs": [
  "jellyfin"
 ],
 "containers": [
  {
   "name": "main",
   "image": "ghcr.io/themightytrex/starboard-plugin-examples:1.1.0",
   "port": 8080,
   "network": "lan",
   "volumes": [
    "data"
   ],
   "start": "when_needed",
   "idle_stop_minutes": 5,
   "env": {
    "EXAMPLE": "watch-stats"
   }
  }
 ],
 "resources": {
  "main": {
   "memory": 64,
   "cpus": 0.25
  }
 },
 "health": "/health",
 "settings": [
  {
   "key": "plays",
   "label": "Recent plays",
   "type": "custom",
   "choices": "/screen/plays"
  },
  {
   "key": "titles",
   "label": "Top titles",
   "type": "custom",
   "choices": "/screen/titles"
  },
  {
   "key": "people",
   "label": "People",
   "type": "custom",
   "choices": "/screen/people"
  },
  {
   "key": "days",
   "label": "Over the last",
   "type": "number",
   "unit": "days",
   "default": 30,
   "min": 1,
   "max": 365
  },
  {
   "key": "leave_out",
   "label": "Leave out these people",
   "type": "list",
   "hint": "One Jellyfin user name a line, such as an account for testing."
  }
 ],
 "actions": [
  {
   "id": "refresh",
   "label": "Read the figures again now",
   "path": "/refresh"
  }
 ],
 "cards": [
  {
   "id": "week",
   "title": "Plays this week",
   "type": "stat",
   "path": "/card/week",
   "format": "number",
   "refresh_minutes": 30,
   "example": {
    "value": 23,
    "label": "plays this week",
    "note": "14.5 hours by 3 people"
   }
  },
  {
   "id": "top",
   "title": "Top titles",
   "type": "list",
   "path": "/card/top",
   "refresh_minutes": 30,
   "example": {
    "items": [
     {
      "title": "Slow Horses",
      "detail": "2 people, 3 plays"
     }
    ]
   }
  },
  {
   "id": "people",
   "title": "Who watched most",
   "type": "list",
   "path": "/card/people",
   "refresh_minutes": 30,
   "example": {
    "items": [
     {
      "title": "Sam",
      "detail": "4.1 hours, 5 plays, most Slow Horses"
     }
    ]
   }
  },
  {
   "id": "source",
   "title": "Watch statistics source",
   "type": "status",
   "path": "/card/source",
   "refresh_minutes": 60,
   "example": {
    "state": "ok",
    "text": "Reading Jellyfin's Playback Reporting"
   }
  }
 ],
 "changes": [
  {
   "version": "1.0.0",
   "date": "2026-11-13",
   "added": [
    "**Three tables:** recent plays by day, top titles and people, each to read only, with search and sorting.",
    "**Four cards:** plays this week, top titles, who watched most, and where the figures come from.",
    "Reads Jellyfin's Playback Reporting with one query, so a Full install can go without Jellystat and its PostgreSQL.",
    "Without Playback Reporting it says so and how to add it, and shows each person's last plays from Jellyfin itself.",
    "Rests when not in use, and keeps each answer for 15 minutes."
   ]
  }
 ]
}
